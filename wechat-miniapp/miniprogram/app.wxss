page{background:#f4f5ef;color:#203e35;font-family:system-ui,-apple-system,sans-serif;font-size:28rpx}view,button,input,textarea{box-sizing:border-box}button{font-size:26rpx;border-radius:18rpx;margin:0;background:#edf3e9;color:#234c3d}button::after{border:0}button[disabled]{opacity:.5}.primary{background:#19634c;color:#fff}.danger{color:#ae4b3c;background:#fff1eb}.muted{color:#7b887e;font-size:24rpx;line-height:1.7}.positive{color:#167458}.negative{color:#b65a45}input,textarea{background:#f4f6f0;border:1rpx solid #dfe6db;border-radius:14rpx;padding:18rpx;font-size:28rpx;min-height:78rpx}textarea{width:100%;height:260rpx}.row{display:flex;align-items:center;justify-content:space-between;gap:16rpx}.actions{display:flex;gap:14rpx;flex-wrap:wrap;margin-top:22rpx}.actions button{flex:1;min-width:180rpx}.card{background:#fff;border:1rpx solid #e3e8de;border-radius:26rpx;padding:28rpx;margin:22rpx 0}.title{font-size:32rpx;font-weight:650}.small{font-size:24rpx}.label{margin:22rpx 0 12rpx;font-size:26rpx}.pill{background:#e5efcf;color:#466137;padding:8rpx 16rpx;border-radius:30rpx;font-size:22rpx}
