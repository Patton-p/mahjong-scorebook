.hero{padding:42rpx 36rpx 70rpx;background:#123f35;color:white}.eyebrow{font-size:23rpx;color:#c4d4c2;letter-spacing:4rpx}.headline{font-size:64rpx;line-height:1.25;font-weight:650;margin:26rpx 0}.hero-sub{color:#cbdbc9;font-size:25rpx}.body{padding:0 24rpx 34rpx}.summary{margin-top:-32rpx;position:relative}.score-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14rpx;margin:25rpx 0}.score{background:#f2f6ec;border-radius:18rpx;padding:22rpx 18rpx;overflow-wrap:anywhere}.score:last-child{grid-column:span 2}.total{font-size:45rpx;font-weight:650;margin-top:15rpx}.robot{display:inline-block;color:#71836b;font-size:20rpx;margin-left:8rpx}.rule{border-top:1rpx solid #e5eadf;padding-top:18rpx}.tabs{display:flex;background:#e7ecdf;border-radius:20rpx;padding:7rpx;margin:28rpx 0 20rpx;font-size:26rpx}.tabs>view{flex:1;text-align:center;padding:18rpx 4rpx;border-radius:16rpx}.tabs .active{background:#fff;box-shadow:0 3rpx 10rpx #203e3509;font-weight:600}.input-row{margin:15rpx 0}.input-row>view{flex:1;min-width:0}.input-row input{width:230rpx;text-align:right}.balance{margin:24rpx 0;background:#f3f6ed;padding:18rpx;border-radius:14rpx;font-size:25rpx}.preview{border:1rpx solid #dfe8d4;background:#f8faf4;border-radius:18rpx;padding:18rpx}.preview-heading{font-size:22rpx;color:#7a8972}.preview-row{padding:14rpx 0;font-size:25rpx}.save{margin:25rpx 0 15rpx}.shot{width:100%;border-radius:18rpx;margin-top:24rpx}.message{padding:20rpx 0}.review{padding:22rpx 0;border-bottom:2rpx solid #e3e9dc;margin-bottom:24rpx}.review-row{padding:18rpx 0}.review-row input{width:250rpx}.review-row .row{margin-top:10rpx}.picker{background:#edf3e9;border-radius:12rpx;padding:20rpx;min-width:220rpx;font-size:25rpx}.raw{display:block;white-space:pre-wrap;background:#f5f6f1;padding:18rpx;font-size:23rpx}.raw-button{margin:16rpx 0;background:#fff;font-size:24rpx}.history-row{padding:18rpx 0;border-bottom:1rpx solid #edf0e7}.right{text-align:right}.empty{text-align:center;padding:65rpx 0;color:#86917f}.footer{text-align:center;color:#8b9683;font-size:23rpx;padding:28rpx}.mask{position:fixed;inset:0;background:#12372cb3;z-index:10;display:flex;align-items:center;justify-content:center;padding:28rpx}.dialog{background:#fff;width:100%;border-radius:26rpx;padding:28rpx;max-height:85vh}.dialog textarea{margin-top:20rpx}.setting-row{margin:18rpx 0}.setting-row input{width:310rpx}.setting-row label{font-size:24rpx;white-space:nowrap}.warning{color:#a54b38}
